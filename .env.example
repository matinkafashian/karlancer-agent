COMPOSE_PROJECT_NAME=karlancer
POSTGRES_DB=karlancer
POSTGRES_USER=karlancer
POSTGRES_PASSWORD=replace-with-a-long-random-password
N8N_VERSION=2.37.11
N8N_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key

RUN_MODE=shadow
SUBMISSION_ENABLED=false
DAILY_SUBMISSION_LIMIT=26
DATABASE_URL=postgresql+asyncpg://karlancer:change-me@postgres:5432/karlancer
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_CHAT_ID=123456789
INTERNAL_API_KEY=replace-with-long-random-key
APPROVAL_SIGNING_KEY=replace-with-at-least-32-random-characters
BROWSER_PROFILE_DIR=/data/browser-profile
BROWSER_HEADLESS=true
# Optional: route only the dedicated Karlancer browser through an Iranian proxy.
# BROWSER_PROXY_SERVER=http://iran-proxy.example:3128
# BROWSER_PROXY_USERNAME=
# BROWSER_PROXY_PASSWORD=
EVIDENCE_DIR=/data/evidence
EVIDENCE_RETENTION_DAYS=7
MODEL_PROVIDER=codex_cli
MODEL_BASE_URL=
MODEL_NAME=gpt-5.6-luna
MODEL_API_KEY=
CODEX_EXECUTABLE=codex
CODEX_REASONING_EFFORT=low
CODEX_TIMEOUT_SECONDS=120
LIVE_REPLY_MONITOR_ENABLED=true
