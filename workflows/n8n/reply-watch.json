{
  "id": "jBYZafxJD2RsEbS5",
  "name": "Karlancer - First Reply Watch",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "schedule-reply-watch",
      "name": "Every 2 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://worker:8000/v1/jobs/reply-watch",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-API-Key",
              "value": "={{ $env.KARLANCER_INTERNAL_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 90000
        }
      },
      "id": "run-reply-watch",
      "name": "Check first employer replies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "errorMessage": "Karlancer first-reply watch failed"
      },
      "id": "surface-reply-watch-error",
      "name": "Surface reply-watch failure",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [780, 440]
    }
  ],
  "connections": {
    "Every 2 minutes": {
      "main": [
        [
          {
            "node": "Check first employer replies",
