{
  "id": "kaIngest01AbCdEf",
  "name": "Karlancer - Ingest Public Projects",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "schedule-ingest",
      "name": "Every 30 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://worker:8000/v1/jobs/ingest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-API-Key",
              "value": "={{ $env.KARLANCER_INTERNAL_API_KEY }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ 'ingest-' + $execution.id }}"
            }
          ]
        },
        "options": {
          "timeout": 90000
        }
      },
      "id": "run-ingest",
      "name": "Ingest channel projects",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "errorMessage": "Karlancer public-channel ingestion failed"
      },
      "id": "surface-ingest-error",
      "name": "Surface ingest failure",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [780, 440]
    }
  ],
  "connections": {
    "Every 30 minutes": {
      "main": [[{"node": "Ingest channel projects", "type": "main", "index": 0}]]
    },
    "Ingest channel projects": {
      "main": [[], [{"node": "Surface ingest failure", "type": "main", "index": 0}]]
    }
  },
  "pinData": {},
  "settings": {"executionOrder": "v1"},
  "active": false,
  "tags": []
}
